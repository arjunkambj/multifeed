{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "ref-app/**",
    "pnpm-lock.yaml",
    "**/.next/**",
    "**/.turbo/**",
    "**/dist/**",
    "**/convex/_generated/**",
    "next-env.d.ts"
  ]
}
