{
  "name": "multifeed",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "pnpm --filter @multifeed/backend test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@multifeed/typescript-config": "workspace:*",
    "@shadcn/lint": "^0.1.0",
    "@trestleinc/convex-oxlint": "^0.2.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "turbo": "^2.10.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
