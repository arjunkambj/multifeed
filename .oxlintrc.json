{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "nextjs"],
  "jsPlugins": ["@shadcn/lint", "@trestleinc/convex-oxlint"],
  "categories": {
    "correctness": "error"
  },
  "settings": {
    "next": {
      "rootDir": "apps/web"
    }
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/dist/**",
    "**/convex/_generated/**",
    "**/*.d.ts",
    "next-env.d.ts",
    "ref-app/**"
  ],
  "rules": {
    "no-extra-boolean-cast": "off",
    "no-shadow-restricted-names": "off",
    "typescript/no-non-null-assertion": "off",
    "typescript/consistent-type-imports": "off",
    "react/no-array-index-key": "off",
    "react-hooks/exhaustive-deps": "warn",
    "react/purity": "off",
    "react/set-state-in-effect": "off",
    "react/static-components": "off",
    "convex/no-old-registered-function-syntax": "error",
    "convex/require-args-validator": "error",
    "convex/explicit-table-ids": "error",
    "convex/import-wrong-runtime": "error",
    "shadcn/no-restyle": ["error", { "allow": ["layout"] }],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": ["error", { "allow": ["layout"] }],
    "shadcn/no-inline-styles": [
      "error",
      {
        "contracts": [
          {
            "pattern": "^motion\\.",
            "allow": ["*"]
          }
        ]
      }
    ],
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error"
  },
  "overrides": [
    {
      "files": ["apps/backend/**"],
      "plugins": ["typescript", "unicorn", "oxc", "import"]
    },
    {
      "files": ["packages/ui/src/components/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/require-static-classes": "off"
      }
    }
  ]
}
